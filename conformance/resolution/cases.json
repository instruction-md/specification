[
  {
    "name": "explicit-body-modifications",
    "documents": {
      "base.md": {
        "format": "instruction/1",
        "uri": "base.md",
        "body": [
          {
            "type": "directive",
            "kind": "instruction",
            "form": "container",
            "attrs": {
              "id": "length"
            },
            "children": [
              {
                "type": "markdown",
                "source": "Original length."
              }
            ]
          },
          {
            "type": "directive",
            "kind": "policy",
            "form": "container",
            "attrs": {
              "id": "priorities"
            },
            "children": [
              {
                "type": "markdown",
                "source": "Commitments first."
              }
            ]
          },
          {
            "type": "directive",
            "kind": "instruction",
            "form": "container",
            "attrs": {
              "id": "obsolete"
            },
            "children": [
              {
                "type": "markdown",
                "source": "Mail routine."
              }
            ]
          }
        ]
      }
    },
    "document": {
      "format": "instruction/1",
      "uri": "child.md",
      "metadata": {
        "front": {
          "extends": [
            {
              "uri": "base.md",
              "as": "personal"
            }
          ]
        }
      },
      "body": [
        {
          "type": "directive",
          "kind": "replace",
          "form": "container",
          "attrs": {
            "target": "#personal/length"
          },
          "children": [
            {
              "type": "markdown",
              "source": "Shorter length."
            }
          ]
        },
        {
          "type": "directive",
          "kind": "extend",
          "form": "container",
          "attrs": {
            "target": "#personal/priorities"
          },
          "children": [
            {
              "type": "markdown",
              "source": "Focus time."
            }
          ]
        },
        {
          "type": "directive",
          "kind": "remove",
          "form": "leaf",
          "attrs": {
            "target": "#personal/obsolete"
          }
        }
      ]
    },
    "expected": [
      {
        "instance": "root/personal",
        "id": "length",
        "kind": "instruction",
        "text": "Shorter length."
      },
      {
        "instance": "root/personal",
        "id": "priorities",
        "kind": "policy",
        "text": "Commitments first.|Focus time."
      }
    ],
    "changes": [
      "replace",
      "extend",
      "remove"
    ]
  },
