{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instruction.md/specification/1/schemas/resolved.schema.json",
  "title": "Resolved instruction snapshot",
  "type": "object",
  "properties": {
    "format": {
      "const": "instruction-resolved/1"
    },
    "status": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "document": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256"
      ],
      "additionalProperties": false
    },
    "body": {
      "type": "array",
      "items": {
        "$ref": "../instruction.schema.json#/$defs/node"
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "instance": {
            "type": "string"
          },
          "alias": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "instance",
          "alias",
          "id",
          "version",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "status": {
            "enum": [
              "resolved",
              "unresolved"
            ]
          },
          "data": {},
          "source": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "key",
          "kind",
          "label",
          "target",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "status": {
            "enum": [
              "resolved",
              "unresolved"
            ]
          },
          "data": {},
          "source": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "key",
          "kind",
          "label",
          "target",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string"
          },
          "resolved_uri": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "mode": {
            "enum": [
              "live",
              "pinned"
            ]
          },
          "version": {
            "type": "string"
          },
          "selector": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "heading": {
                    "type": "string"
                  },
                  "occurrence": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "heading"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "lines": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "integer",
                        "minimum": 1
                      }
                    ],
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "required": [
                  "lines"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "pointer": {
                    "type": "string",
                    "pattern": "^(?:/(?:[^~]|~[01])*)*$"
                  }
                },
                "required": [
                  "pointer"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "page": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "page"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "time": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "required": [
                  "time"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "region": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "minItems": 4,
                    "maxItems": 4
                  }
                },
                "required": [
                  "region"
                ],
                "additionalProperties": false
              }
            ]
          },
          "instance": {
            "type": "string"
          },
          "extensions": {
            "type": "object"
          }
        },
        "required": [
          "uri",
          "resolved_uri",
          "sha256",
          "mode",
          "instance"
        ],
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "instance": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "range": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 1
              },
              "end": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "selector": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "heading": {
                    "type": "string"
                  },
                  "occurrence": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "heading"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "lines": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "integer",
                        "minimum": 1
                      }
                    ],
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "required": [
                  "lines"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "pointer": {
                    "type": "string",
                    "pattern": "^(?:/(?:[^~]|~[01])*)*$"
                  }
                },
                "required": [
                  "pointer"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "page": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "page"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "time": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "required": [
                  "time"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "region": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "minItems": 4,
                    "maxItems": 4
                  }
                },
                "required": [
                  "region"
                ],
                "additionalProperties": false
              }
            ]
          },
          "operation": {
            "enum": [
              "include",
              "inherit",
              "replace",
              "extend",
              "remove"
            ]
          },
          "target": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "modified_by": {
            "type": "string"
          },
          "original": {}
        },
        "required": [
          "instance",
          "uri"
        ],
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "message": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "range": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 1
              },
              "end": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "target": {
            "type": "string"
          },
          "remedy": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "severity",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "resolved_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "format",
    "status",
    "document",
    "body",
    "extensions",
    "objects",
    "resources",
    "dependencies",
    "provenance",
    "diagnostics"
  ],
  "additionalProperties": false
}
