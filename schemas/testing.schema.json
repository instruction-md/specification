{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instruction.md/specification/1/schemas/testing.schema.json",
  "title": "Instruction test exchange",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "format": {
          "const": "instruction-test-request/1"
        },
        "id": {
          "type": "string"
        },
        "document_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "target": {
          "type": "string"
        },
        "adapter": {
          "type": "string"
        },
        "inputs": {},
        "profile": {
          "type": "string"
        },
        "model": {
          "type": "object"
        }
      },
      "required": [
        "format",
        "id",
        "document_digest",
        "target",
        "adapter",
        "inputs"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "format": {
          "const": "instruction-test-result/1"
        },
        "request": {
          "type": "string"
        },
        "document_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "error",
            "skipped"
          ]
        },
        "environment": {
          "type": "object"
        },
        "started": {
          "type": "string",
          "format": "date-time"
        },
        "finished": {
          "type": "string",
          "format": "date-time"
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "error",
                  "skipped"
                ]
              },
              "detail": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uri": {
                "type": "string"
              },
              "select": {
                "$ref": "#/$defs/selector"
              },
              "mode": {
                "enum": [
                  "live",
                  "pinned"
                ]
              },
              "version": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "required": {
                "type": "boolean"
              },
              "as": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "with": {
                "type": "object"
              }
            },
            "required": [
              "uri"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "mode": {
                      "const": "pinned"
                    }
                  },
                  "required": [
                    "mode"
                  ]
                },
                "then": {
                  "required": [
                    "sha256"
                  ]
                }
              }
            ]
          }
        }
      },
      "required": [
        "format",
        "request",
        "document_digest",
        "status",
        "environment",
        "started",
        "finished",
        "assertions",
        "artifacts"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "heading": {
              "type": "string"
            },
            "occurrence": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "heading"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "lines": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ],
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "lines"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "pointer": {
              "type": "string",
              "pattern": "^(?:/(?:[^~]|~[01])*)*$"
            }
          },
          "required": [
            "pointer"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "page": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "page"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "time": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "time"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "region": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 4,
              "maxItems": 4
            }
          },
          "required": [
            "region"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
