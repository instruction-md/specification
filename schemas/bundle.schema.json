{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instruction.md/specification/1/schemas/bundle.schema.json",
  "title": "Instruction bundle manifest",
  "type": "object",
  "properties": {
    "format": {
      "const": "instruction-bundle/1"
    },
    "main": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*\\\\)[^/]+(?:/[^/]+)*$"
    },
    "complete": {
      "type": "boolean"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*\\\\)[^/]+(?:/[^/]+)*$"
          },
          "media_type": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "uri": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "live",
              "pinned"
            ]
          }
        },
        "required": [
          "path",
          "media_type",
          "sha256",
          "uri"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "mapping": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*\\\\)[^/]+(?:/[^/]+)*$"
      }
    },
    "exports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "agent-instructions",
              "config",
              "workflow",
              "skill",
              "resource"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*\\\\)[^/]+(?:/[^/]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "adapter": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "dialect": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "uri": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "select": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "heading": {
                          "type": "string"
                        },
                        "occurrence": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "required": [
                        "heading"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "lines": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "integer",
                              "minimum": 1
                            },
                            {
                              "type": "integer",
                              "minimum": 1
                            }
                          ],
                          "minItems": 2,
                          "maxItems": 2
                        }
                      },
                      "required": [
                        "lines"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "pointer": {
                          "type": "string",
                          "pattern": "^(?:/(?:[^~]|~[01])*)*$"
                        }
                      },
                      "required": [
                        "pointer"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "page": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "required": [
                        "page"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "time": {
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "minItems": 2,
                          "maxItems": 2
                        }
                      },
                      "required": [
                        "time"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "region": {
                          "type": "array",
                          "items": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "minItems": 4,
                          "maxItems": 4
                        }
                      },
                      "required": [
                        "region"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "uri",
                "sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "sha256",
          "adapter",
          "profile",
          "sources"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "main",
    "complete",
    "entries",
    "mapping"
  ],
  "additionalProperties": false
}
